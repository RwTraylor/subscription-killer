# Copy to .env and fill in. Never commit the real one.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = sandbox (hackathon demo), false = production
PAYPAL_SANDBOX=true
# Optional: AI provider key for the LLM explanation layer.
# Without it, the analyzer falls back to deterministic heuristics.
AI_API_KEY=
AI_MODEL=
